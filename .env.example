# ------------------------------
# RLAIF runtime configuration
# ------------------------------

HOE_SQLITE_PATH=var/rlaif.db
HOE_APPROVAL_OWNER_NAME=Ram Sharma

# Git integration
HOE_GITHUB_REPO=ramsharma77/rlaif
HOE_GITHUB_BASE=main

# Input traces (JSONL rows with nested traces[])
HOE_TRACE_FILE_PATHS=C:/projects/proposal/Verizon/Verizon_ivr_agent/traces_real_PROD export on 91426 at 50157 PM CDT.jsonl;C:/projects/proposal/Verizon/Verizon_ivr_agent/traces_PROD export on 92426 at 102050 PM CDT.jsonl

# Ingestion guardrails
HOE_INGEST_LINE_MAX_BYTES=1572864
HOE_INGEST_TRACE_SOFT_MAX_BYTES=512000
HOE_INGEST_QUARANTINE_DIR=var/quarantine

# Semantic clustering
HOE_SEMANTIC_ENABLED=true
HOE_SEMANTIC_RUNTIME=llama_cpp_server
HOE_SEMANTIC_FALLBACK_ENABLED=true
HOE_SEMANTIC_MAX_ITEMS=80
HOE_SEMANTIC_TOP_K=6

# Local SLM / llama.cpp
HOE_SLM_SOURCE_DIR=C:/projects/proposal/Verizon/SLM
HOE_SLM_REPO_DIR=models/gguf
HOE_SLM_MODEL_PATTERN=qwen*.gguf
HOE_LLAMA_SERVER_URL=http://127.0.0.1:8080
HOE_LLAMA_TIMEOUT_SEC=20
HOE_LLAMA_SERVER_EXECUTABLE=
HOE_LLAMA_SERVER_THREADS=8
HOE_LLAMA_SERVER_CTX_SIZE=4096
HOE_LLAMA_SERVER_GPU_LAYERS=0

# Anthropic fallback (used only when local clustering runtime is unavailable/fails)
HOE_ANTHROPIC_FALLBACK_MODEL=claude-3-5-haiku-latest

# Optimizer controls
HOE_OPT_BUDGET=6000
HOE_OPT_MINIBATCH=40
HOE_OPT_N_OPT=200
HOE_OPT_N_SEL=300
HOE_OPT_N_CONF=600
HOE_OPT_TOP_K=3
HOE_OPT_EPSILON=0.2
HOE_OPT_DIMENSIONS=lines,gates,tools
HOE_OPT_TOP_P_DIMENSIONS=3

# Reward and KPI controls
HOE_DEFAULT_REWARD_WEIGHTS={"resolution":1.0,"tokens":0.15,"latency":0.05,"empathy":0.0,"policy":2.0}
HOE_BUSINESS_KPIS=failure_rate_by_bucket,retry_escalation_rate,policy_violation_incidence,cost_per_eval_run,trace_p95_latency,precision_recall_f1

# RL controls
HOE_RL_ALGORITHM=grpo
HOE_RL_ITERATIONS=30
HOE_RL_BATCH=12
HOE_RL_GROUP=4
HOE_RL_LR=0.5
HOE_RL_KL_COEF=0.05
HOE_RL_BETA=0.5
HOE_RL_EVAL_EVERY=5
HOE_RL_EVAL_N=200
